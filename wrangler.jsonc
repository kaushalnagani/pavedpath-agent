{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pavedpath-ai",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "PavedPathAgent", "class_name": "PavedPathAgent" }
    ]
  },
  "workflows": [
    {
      "name": "policy-review-workflow",
      "binding": "POLICY_REVIEW_WORKFLOW",
      "class_name": "PolicyReviewWorkflow"
    }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PavedPathAgent"] }
  ],
  "observability": { "enabled": true }
}
